{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    // Generated by scripts/; formatting them would fight the generators' --check mode.
    "files": {
        "includes": [
            "**",
            "!src/scverse_doc/registry.json",
            "!src/scverse_doc/theme/scverse/static/_tokens.css",
        ],
    },
    "formatter": { "useEditorconfig": true },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
        },
    },
    "overrides": [
        {
            "includes": ["./.vscode/*.json", "**/*.jsonc"],
            "json": {
                "formatter": { "trailingCommas": "all" },
                "parser": {
                    "allowComments": true,
                    "allowTrailingCommas": true,
                },
            },
        },
        // HTML formatting is opt-in; most templates contain Jinja inside tags, which Biome can't parse.
        {
            "includes": [
                "src/scverse_doc/theme/scverse/components/sidebar-versions.html",
            ],
            "html": { "formatter": { "enabled": true } },
        },
    ],
}
